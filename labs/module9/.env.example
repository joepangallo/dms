# Copy this file to .env and fill in real values. .env is gitignored on
# purpose (see the repo's .gitignore) -- it holds a real password, and this
# is a public repository.
#
# DB_USER should NOT be root, beyond a throwaway personal sandbox on your
# own machine. Create a dedicated, least-privilege MySQL user for this app
# instead -- one that can only SELECT/INSERT/UPDATE/DELETE on the practice
# database this module uses, and nothing else. See the README's "Use a
# least-privilege database user" section for the CREATE USER/GRANT
# statements and the reasoning behind them: an app that only ever needs
# CRUD access to one database has no business connecting as the one account
# that can drop every database on the server.

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=practice_db
